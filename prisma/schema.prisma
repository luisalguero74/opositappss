generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Supabase con pooler (puerto 6xxx) - DIRECT_URL no necesario
}

enum RepoRole {
  NONE
  READER
  EDITOR
}

enum RepoAccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum QuestionOrigin {
  UNKNOWN
  CRON
  JSON
  MANUAL
}

enum QuestionReviewStatus {
  PENDING
  VALIDATED
  QUARANTINED
}

model User {
  id                    String                  @id @default(cuid())
  email                 String                  @unique
  name                  String?
  password              String?
  phoneNumber           String?                 @unique
  emailVerified         DateTime?
  role                  String                  @default("user")
  repoRole              RepoRole                @default(NONE)
  active                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  accounts              Account[]
  classroomParticipants ClassroomParticipant[]
  examOfficialAttempts  ExamOfficialAttempt[]   @relation("UserExamAttempts")
  examRankings          ExamRanking[]           @relation("UserExamRankings")
  examSimulations       ExamSimulation[]
  posts                 ForumPost[]             @relation("UserPosts")
  threads               ForumThread[]           @relation("UserThreads")
  markedQuestions       MarkedQuestion[]        @relation("UserMarkedQuestions")
  notifications         Notification[]          @relation("UserNotifications")
  attempts              QuestionnaireAttempt[]
  repoAccessLogs        RepoDocumentAccessLog[] @relation("UserRepoAccessLogs")
  repoAccessRequests    RepoAccessRequest[]     @relation("RepoAccessRequestsUser")
  repoAccessDecisions   RepoAccessRequest[]     @relation("RepoAccessRequestsDecidedBy")
  sessions              Session[]
  spacedCards           SpacedRepetitionCard[]  @relation("UserSpacedCards")
  studySessions         StudySession[]          @relation("UserStudySessions")
  streak                StudyStreak?            @relation("UserStreak")
  subscription          Subscription?
  achievements          UserAchievement[]       @relation("UserAchievements")
  userAnswers           UserAnswer[]
  questionNotes         QuestionNote[]          @relation("UserQuestionNotes")
  createdClassrooms     VirtualClassroom[]      @relation("ClassroomCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Questionnaire {
  id                     String                   @id @default(cuid())
  title                  String
  type                   String
  theme                  String?
  statement              String?
  category               String?
  published              Boolean                  @default(false)
  archived               Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  questions              Question[]               // Relación legacy (mantener por compatibilidad)
  questionnaireQuestions QuestionnaireQuestion[]  // Nueva relación N:N
  attempts               QuestionnaireAttempt[]
  solutions              Solution?
  userAnswers            UserAnswer[]
}

model Question {
  id                     String                   @id @default(cuid())
  questionnaireId        String?                  // OPCIONAL: para compatibilidad legacy
  temaId                 String?                  // NUEVO: vinculación a TemaOficial
  text                   String
  options                String
  correctAnswer          String
  explanation            String
  origin                 QuestionOrigin           @default(UNKNOWN)
  reviewStatus           QuestionReviewStatus     @default(PENDING)
  temaCodigo             String?
  temaNumero             Int?
  temaParte              String?
  temaTitulo             String?
  difficulty             String?
  aiReviewed             Boolean?                 @default(false)
  aiReviewedAt           DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  markedBy               MarkedQuestion[]         @relation("MarkedQuestions")
  questionnaire          Questionnaire?           @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  tema                   TemaOficial?             @relation(fields: [temaId], references: [id], onDelete: SetNull)
  questionnaireQuestions QuestionnaireQuestion[]  // Nueva relación N:N
  spacedCards            SpacedRepetitionCard[]   @relation("SpacedRepetitionCards")
  userAnswers            UserAnswer[]
  notes                  QuestionNote[]           @relation("QuestionNotes")

  @@index([reviewStatus, origin, createdAt])
  @@index([temaId])
  @@index([questionnaireId])
}

model Solution {
  id              String        @id @default(cuid())
  questionnaireId String        @unique
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}

// NUEVO: Tabla intermedia para relación N:N entre Questionnaire y Question
model QuestionnaireQuestion {
  id              String        @id @default(cuid())
  questionnaireId String
  questionId      String
  order           Int           // Orden de la pregunta en el cuestionario
  createdAt       DateTime      @default(now())
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  question        Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId, questionId])
  @@index([questionnaireId])
  @@index([questionId])
  @@index([order])
}

model UserAnswer {
  id              String                @id @default(cuid())
  userId          String
  questionId      String
  questionnaireId String
  attemptId       String?
  answer          String
  isCorrect       Boolean
  createdAt       DateTime              @default(now())
  attempt         QuestionnaireAttempt? @relation(fields: [attemptId], references: [id])
  question        Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionnaire   Questionnaire         @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuestionnaireAttempt {
  id              String        @id @default(cuid())
  userId          String
  questionnaireId String
  score           Int
  correctAnswers  Int
  totalQuestions  Int
  timeSpent       Int?
  completedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         UserAnswer[]

  @@index([userId, questionnaireId])
}

model ForumThread {
  id        String      @id @default(cuid())
  title     String
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  posts     ForumPost[]
  user      User        @relation("UserThreads", fields: [userId], references: [id], onDelete: Cascade)
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  userId    String
  content   String
  createdAt DateTime    @default(now())
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User        @relation("UserPosts", fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  plan              String
  status            String
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  source            String?
  label             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id                    String   @id @default(cuid())
  monetizationEnabled   Boolean  @default(false)
  freeAccessDays        Int      @default(7)
  basicPrice            Float    @default(9.99)
  premiumPrice          Float    @default(19.99)
  currency              String   @default("EUR")
  adsEnabled            Boolean  @default(false)
  adsenseClientId       String?
  affiliatesEnabled     Boolean  @default(false)
  amazonAffiliateId     String?
  sponsorsEnabled       Boolean  @default(false)
  donationsEnabled      Boolean  @default(false)
  patreonUrl            String?
  kofiUrl               String?
  premiumContentEnabled Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model ExamSimulation {
  id              String    @id @default(cuid())
  userId          String
  theoryQuestions String
  practicalCase   String
  userAnswers     String
  score           Int
  theoryScore     Int
  practicalScore  Int
  timeSpent       Int
  completed       Boolean   @default(false)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExamOfficial {
  id            String                @id @default(cuid())
  title         String
  description   String?
  testQuestions String
  practicalCase String
  published     Boolean               @default(false)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  attempts      ExamOfficialAttempt[] @relation("ExamAttempts")
}

model ExamOfficialAttempt {
  id                 String       @id @default(cuid())
  examId             String
  userId             String
  testAnswers        String
  practicalAnswers   String
  testCorrect        Int
  testIncorrect      Int
  testBlank          Int
  testRawScore       Float
  testScore          Float
  practicalCorrect   Int
  practicalIncorrect Int
  practicalBlank     Int
  practicalRawScore  Float
  practicalScore     Float
  totalScore         Float
  timeSpent          Int
  completed          Boolean      @default(false)
  startedAt          DateTime     @default(now())
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  exam               ExamOfficial @relation("ExamAttempts", fields: [examId], references: [id], onDelete: Cascade)
  user               User         @relation("UserExamAttempts", fields: [userId], references: [id], onDelete: Cascade)
  ranking            ExamRanking? @relation("AttemptRanking")

  @@index([userId, completedAt])
  @@index([examId, totalScore])
}

model ExamRanking {
  id         String              @id @default(cuid())
  userId     String
  attemptId  String              @unique
  rank       Int
  totalScore Float
  userName   String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  attempt    ExamOfficialAttempt @relation("AttemptRanking", fields: [attemptId], references: [id], onDelete: Cascade)
  user       User                @relation("UserExamRankings", fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalScore(sort: Desc)])
  @@index([rank])
}

model VirtualClassroom {
  id              String                 @id @default(cuid())
  name            String
  description     String?
  roomId          String                 @unique
  password        String?
  maxParticipants Int                    @default(50)
  active          Boolean                @default(true)
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sessions        ClassSession[]
  participants    ClassroomParticipant[]
  createdBy       User                   @relation("ClassroomCreator", fields: [createdById], references: [id], onDelete: Cascade)
}

model ClassSession {
  id           String           @id @default(cuid())
  classroomId  String
  title        String
  description  String?
  scheduledAt  DateTime
  duration     Int
  status       String           @default("scheduled")
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  classroom    VirtualClassroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
}

model ClassroomParticipant {
  id             String           @id @default(cuid())
  classroomId    String
  userId         String
  role           String           @default("student")
  canSpeak       Boolean          @default(true)
  canShareScreen Boolean          @default(false)
  isBanned       Boolean          @default(false)
  joinedAt       DateTime         @default(now())
  classroom      VirtualClassroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
}

model LegalDocument {
  id           String              @id @default(cuid())
  title        String
  documentType String
  content      String
  metadata     String?
  embedding    String?
  topic        String?
  active       Boolean             @default(true)
  reference    String?
  fileName     String?
  fileSize     Int?
  processedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sections     DocumentSection[]
  questions    GeneratedQuestion[]
  temas        TemaLegalDocument[]
}

model DocumentSection {
  id         String              @id @default(cuid())
  documentId String
  title      String
  content    String
  order      Int
  embedding  String?
  createdAt  DateTime            @default(now())
  document   LegalDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions  GeneratedQuestion[]
}

model GeneratedQuestion {
  id            String           @id @default(cuid())
  documentId    String
  sectionId     String?
  text          String
  options       String
  correctAnswer String
  explanation   String?
  difficulty    String           @default("medium")
  topic         String?
  reviewed      Boolean          @default(false)
  approved      Boolean          @default(false)
  reviewedBy    String?
  reviewedAt    DateTime?
  usageCount    Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  document      LegalDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section       DocumentSection? @relation(fields: [sectionId], references: [id])
}

model TemaOficial {
  id            String              @id
  numero        Int
  titulo        String
  descripcion   String
  categoria     String
  normativaBase String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  archivos      TemaArchivo[]
  documentos    TemaLegalDocument[]
  preguntas     Question[]          // NUEVO: Relación con preguntas

  @@unique([categoria, numero])
}

model TemaArchivo {
  id            String      @id @default(cuid())
  temaId        String
  nombre        String
  numeroPaginas Int         @default(0)
  uploadedAt    DateTime    @default(now())
  tema          TemaOficial @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@index([temaId])
}

model TemaLegalDocument {
  id         String        @id @default(cuid())
  temaId     String
  documentId String
  createdAt  DateTime      @default(now())
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tema       TemaOficial   @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@unique([temaId, documentId])
  @@index([temaId])
  @@index([documentId])
}

model RepoFolder {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  parentId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  documents   RepoDocument[]
  parent      RepoFolder?    @relation("RepoFolderParent", fields: [parentId], references: [id])
  children    RepoFolder[]   @relation("RepoFolderParent")
}

model RepoDocument {
  id            String                  @id @default(cuid())
  folderId      String
  title         String
  fileName      String
  storagePath   String
  storageBucket String?
  fileType      String?
  fileSize      Int?
  pages         Int?
  isActive      Boolean                 @default(true)
  allowDownload Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  folder        RepoFolder              @relation(fields: [folderId], references: [id], onDelete: Cascade)
  accessLogs    RepoDocumentAccessLog[]

  @@index([folderId])
}

model RepoDocumentAccessLog {
  id         String       @id @default(cuid())
  documentId String
  userId     String?
  action     String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())
  document   RepoDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User?        @relation("UserRepoAccessLogs", fields: [userId], references: [id])

  @@index([documentId, createdAt])
  @@index([userId, createdAt])
}

model RepoAccessRequest {
  id             String                   @id @default(cuid())
  userId         String
  desiredRole    RepoRole
  status         RepoAccessRequestStatus @default(PENDING)
  createdAt      DateTime                 @default(now())
  decidedAt      DateTime?
  decidedByUserId String?
  reason         String?

  user           User                     @relation("RepoAccessRequestsUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy      User?                    @relation("RepoAccessRequestsDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, status])
}

model AllowedPhoneNumber {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  groupName   String?
  scholarshipOverride Boolean?
  addedAt     DateTime @default(now())

  @@index([phoneNumber])
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String?
  email     String
  phone     String
  note      String?
  source    String?
  createdAt DateTime @default(now())
}

model StudyStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastStudyDate  DateTime?
  totalStudyDays Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation("UserStreak", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MarkedQuestion {
  id          String    @id @default(cuid())
  userId      String
  questionId  String
  type        String
  timesFailed Int       @default(0)
  lastFailed  DateTime?
  markedAt    DateTime  @default(now())
  reviewedAt  DateTime?
  notes       String?
  question    Question  @relation("MarkedQuestions", fields: [questionId], references: [id], onDelete: Cascade)
  user        User      @relation("UserMarkedQuestions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, type])
}

model Achievement {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  description      String
  icon             String
  category         String
  requirement      String
  points           Int               @default(0)
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  progress      Int         @default(100)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model SpacedRepetitionCard {
  id             String    @id @default(cuid())
  userId         String
  questionId     String
  easeFactor     Float     @default(2.5)
  interval       Int       @default(1)
  repetitions    Int       @default(0)
  nextReviewDate DateTime
  lastReviewedAt DateTime?
  totalReviews   Int       @default(0)
  correctReviews Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  question       Question  @relation("SpacedRepetitionCards", fields: [questionId], references: [id], onDelete: Cascade)
  user           User      @relation("UserSpacedCards", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewDate])
}

model StudySession {
  id                String    @id @default(cuid())
  userId            String
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  duration          Int?
  questionsAnswered Int       @default(0)
  correctAnswers    Int       @default(0)
  topics            String?
  type              String
  user              User      @relation("UserStudySessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model SystemError {
  id         String    @id @default(cuid())
  errorType  String
  severity   String    @default("medium")
  endpoint   String?
  statusCode Int?
  message    String
  stack      String?
  userEmail  String?
  userId     String?
  context    String?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([errorType, createdAt])
  @@index([severity, resolved])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  adminId    String
  adminEmail String
  changes    String?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([adminId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}

model FailedLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  userAgent String?
  reason    String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model BackupLog {
  id             String    @id @default(cuid())
  backupType     String
  status         String    @default("pending")
  backupSize     BigInt?
  backupLocation String?
  tablesBackedUp String?
  recordsCount   Int?
  duration       Int?
  errorMessage   String?
  initiatedBy    String?
  metadata       String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  nextScheduled  DateTime?

  @@index([status, startedAt])
  @@index([backupType, startedAt])
}

model DataExport {
  id           String    @id @default(cuid())
  exportType   String
  format       String    @default("json")
  filters      String?
  recordCount  Int?
  fileSize     BigInt?
  downloadUrl  String?
  expiresAt    DateTime?
  adminId      String
  adminEmail   String
  status       String    @default("completed")
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([exportType, createdAt])
}

model SystemHealth {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  databaseStatus  String
  apiResponseTime Int
  errorRate       Float
  activeUsers     Int
  queuedTasks     Int
  memoryUsage     Int?
  cpuUsage        Float?
  context         String?

  @@index([timestamp])
}

model MonetizationConfig {
  id         String    @id @default(cuid())
  platform   String    @unique
  enabled    Boolean   @default(true)
  config     String
  metadata   String?
  lastSync   DateTime?
  errorCount Int       @default(0)
  lastError  String?
  updatedAt  DateTime  @updatedAt
}

model MonetizationStat {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  platform         String
  revenue          Float    @default(0)
  transactionCount Int      @default(0)
  uniquePatrons    Int      @default(0)
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  ctr              Float?
  context          String?

  @@index([platform, date])
  @@index([date])
}

model BoeMonitorRun {
  id              String   @id @default(cuid())
  job             String
  publicationDate DateTime
  success         Boolean  @default(false)
  scannedItems    Int      @default(0)
  matchedItems    Int      @default(0)
  newItems        Int      @default(0)
  error           String?
  createdAt       DateTime @default(now())

  items BoeAlertItem[]

  @@unique([job, publicationDate])
  @@index([job, createdAt])
  @@index([publicationDate])
}

model BoeAlertItem {
  id              String   @id @default(cuid())
  runId           String
  publicationDate DateTime
  canonicalKey    String   @unique
  boeId           String?
  title           String
  urlHtml         String
  urlPdf          String?
  section         String?
  department      String?
  epigrafe        String?
  score           Int      @default(0)
  reasons         String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  run BoeMonitorRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([isRead, publicationDate])
  @@index([publicationDate, createdAt])
}

// Notas personales del usuario en preguntas
model QuestionNote {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  user     User     @relation("UserQuestionNotes", fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation("QuestionNotes", fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}
