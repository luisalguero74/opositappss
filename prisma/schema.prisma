generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  password              String?
  role                  String                 @default("user")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  emailVerified         DateTime?
  active                Boolean                @default(true)
  name                  String?
  phoneNumber           String?                @unique
  accounts              Account[]
  classroomParticipants ClassroomParticipant[]
  examSimulations       ExamSimulation[]
  posts                 ForumPost[]            @relation("UserPosts")
  threads               ForumThread[]          @relation("UserThreads")
  markedQuestions       MarkedQuestion[]       @relation("UserMarkedQuestions")
  notifications         Notification[]         @relation("UserNotifications")
  attempts              QuestionnaireAttempt[]
  sessions              Session[]
  spacedCards           SpacedRepetitionCard[] @relation("UserSpacedCards")
  studySessions         StudySession[]         @relation("UserStudySessions")
  streak                StudyStreak?           @relation("UserStreak")
  subscription          Subscription?
  achievements          UserAchievement[]      @relation("UserAchievements")
  userAnswers           UserAnswer[]
  createdClassrooms     VirtualClassroom[]     @relation("ClassroomCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Questionnaire {
  id          String                 @id @default(cuid())
  title       String
  type        String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  published   Boolean                @default(false)
  statement   String?
  theme       String?
  category    String?
  questions   Question[]
  attempts    QuestionnaireAttempt[]
  solutions   Solution?
  userAnswers UserAnswer[]
}

model Question {
  id              String                 @id @default(cuid())
  questionnaireId String
  text            String
  options         String
  correctAnswer   String
  explanation     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  temaCodigo      String?
  temaNumero      Int?
  temaParte       String?
  temaTitulo      String?
  difficulty      String?
  markedBy        MarkedQuestion[]       @relation("MarkedQuestions")
  questionnaire   Questionnaire          @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  spacedCards     SpacedRepetitionCard[] @relation("SpacedRepetitionCards")
  userAnswers     UserAnswer[]
}

model Solution {
  id              String        @id @default(cuid())
  questionnaireId String        @unique
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}

model UserAnswer {
  id              String                @id @default(cuid())
  userId          String
  questionId      String
  questionnaireId String
  answer          String
  isCorrect       Boolean
  createdAt       DateTime              @default(now())
  attemptId       String?
  attempt         QuestionnaireAttempt? @relation(fields: [attemptId], references: [id])
  question        Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionnaire   Questionnaire         @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuestionnaireAttempt {
  id              String        @id @default(cuid())
  userId          String
  questionnaireId String
  score           Int
  correctAnswers  Int
  totalQuestions  Int
  timeSpent       Int?
  completedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         UserAnswer[]

  @@index([userId, questionnaireId])
}

model ForumThread {
  id        String      @id @default(cuid())
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  posts     ForumPost[]
  user      User        @relation("UserThreads", fields: [userId], references: [id], onDelete: Cascade)
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  content   String
  createdAt DateTime    @default(now())
  userId    String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User        @relation("UserPosts", fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  plan              String
  status            String
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id                    String   @id @default(cuid())
  monetizationEnabled   Boolean  @default(false)
  freeAccessDays        Int      @default(7)
  basicPrice            Float    @default(9.99)
  premiumPrice          Float    @default(19.99)
  currency              String   @default("EUR")
  updatedAt             DateTime @updatedAt
  adsEnabled            Boolean  @default(false)
  adsenseClientId       String?
  affiliatesEnabled     Boolean  @default(false)
  amazonAffiliateId     String?
  donationsEnabled      Boolean  @default(false)
  kofiUrl               String?
  patreonUrl            String?
  premiumContentEnabled Boolean  @default(false)
  sponsorsEnabled       Boolean  @default(false)
}

model ExamSimulation {
  id              String    @id @default(cuid())
  userId          String
  theoryQuestions String
  practicalCase   String
  userAnswers     String
  score           Int
  theoryScore     Int
  practicalScore  Int
  timeSpent       Int
  completed       Boolean   @default(false)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VirtualClassroom {
  id              String                 @id @default(cuid())
  name            String
  description     String?
  roomId          String                 @unique
  password        String?
  maxParticipants Int                    @default(50)
  active          Boolean                @default(true)
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sessions        ClassSession[]
  participants    ClassroomParticipant[]
  createdBy       User                   @relation("ClassroomCreator", fields: [createdById], references: [id], onDelete: Cascade)
}

model ClassSession {
  id           String           @id @default(cuid())
  classroomId  String
  title        String
  description  String?
  scheduledAt  DateTime
  duration     Int
  status       String           @default("scheduled")
  startedAt    DateTime?
  endedAt      DateTime?
  recordingUrl String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  classroom    VirtualClassroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
}

model ClassroomParticipant {
  id             String           @id @default(cuid())
  classroomId    String
  userId         String
  role           String           @default("student")
  canSpeak       Boolean          @default(true)
  canShareScreen Boolean          @default(false)
  isBanned       Boolean          @default(false)
  joinedAt       DateTime         @default(now())
  classroom      VirtualClassroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
}

model LegalDocument {
  id          String              @id @default(cuid())
  title       String
  type        String
  reference   String?
  fileName    String?
  fileSize    Int?
  content     String
  processedAt DateTime?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  topic       String?
  sections    DocumentSection[]
  questions   GeneratedQuestion[]
  temas       TemaLegalDocument[]
}

model TemaLegalDocument {
  id         String       @id @default(cuid())
  temaId     String
  documentId String
  createdAt  DateTime     @default(now())

  tema      TemaOficial   @relation(fields: [temaId], references: [id], onDelete: Cascade)
  document  LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([temaId, documentId])
  @@index([temaId])
  @@index([documentId])
}

model DocumentSection {
  id         String              @id @default(cuid())
  documentId String
  title      String
  content    String
  order      Int
  createdAt  DateTime            @default(now())
  document   LegalDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions  GeneratedQuestion[]
}

model GeneratedQuestion {
  id            String           @id @default(cuid())
  documentId    String
  sectionId     String?
  text          String
  options       String
  correctAnswer String
  explanation   String?
  difficulty    String           @default("medium")
  reviewed      Boolean          @default(false)
  approved      Boolean          @default(false)
  reviewedBy    String?
  reviewedAt    DateTime?
  usageCount    Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  topic         String?
  document      LegalDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section       DocumentSection? @relation(fields: [sectionId], references: [id])
}

model TemaOficial {
  id            String        @id
  numero        Int
  titulo        String
  descripcion   String
  categoria     String
  normativaBase String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  archivos      TemaArchivo[]
  documentosLegales TemaLegalDocument[]

  @@unique([categoria, numero])
}

model TemaArchivo {
  id            String      @id @default(cuid())
  temaId        String
  nombre        String
  numeroPaginas Int         @default(0)
  uploadedAt    DateTime    @default(now())
  tema          TemaOficial @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@index([temaId])
}

model AllowedPhoneNumber {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  groupName   String?
  addedAt     DateTime @default(now())

  @@index([phoneNumber])
}

model StudyStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastStudyDate  DateTime?
  totalStudyDays Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation("UserStreak", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MarkedQuestion {
  id          String    @id @default(cuid())
  userId      String
  questionId  String
  type        String
  timesFailed Int       @default(0)
  lastFailed  DateTime?
  markedAt    DateTime  @default(now())
  reviewedAt  DateTime?
  notes       String?
  question    Question  @relation("MarkedQuestions", fields: [questionId], references: [id], onDelete: Cascade)
  user        User      @relation("UserMarkedQuestions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, type])
}

model Achievement {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  description      String
  icon             String
  category         String
  requirement      String
  createdAt        DateTime          @default(now())
  points           Int               @default(0)
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  progress      Int         @default(100)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model SpacedRepetitionCard {
  id             String    @id @default(cuid())
  userId         String
  questionId     String
  easeFactor     Float     @default(2.5)
  interval       Int       @default(1)
  repetitions    Int       @default(0)
  nextReviewDate DateTime
  lastReviewedAt DateTime?
  totalReviews   Int       @default(0)
  correctReviews Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  question       Question  @relation("SpacedRepetitionCards", fields: [questionId], references: [id], onDelete: Cascade)
  user           User      @relation("UserSpacedCards", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewDate])
}

model StudySession {
  id                String    @id @default(cuid())
  userId            String
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  duration          Int?
  questionsAnswered Int       @default(0)
  correctAnswers    Int       @default(0)
  topics            String?
  type              String
  user              User      @relation("UserStudySessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model SystemError {
  id         String    @id @default(cuid())
  errorType  String
  severity   String    @default("medium")
  endpoint   String?
  statusCode Int?
  message    String
  stack      String?
  userEmail  String?
  userId     String?
  context    String?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([errorType, createdAt])
  @@index([severity, resolved])
  @@index([createdAt])
}
